extends SceneTree

var failed := false

func _initialize() -> void:
	call_deferred("_run_tests")

func _check(condition: bool, message: String) -> void:
	if condition:
		print("PASS: ", message)
	else:
		push_error("FAIL: " + message)
		failed = true

func _run_tests() -> void:
	var save_path := "user://eldervale_progress.cfg"
	var save := ConfigFile.new()
	var weapon := {"id": 41, "name": "Roundtrip Fang", "slot": "weapon", "rarity": "Epic", "source": "CI test", "enhancement_level": 2, "attack": 7, "hp": 0, "mitigation": 0}
	var armor := {"id": 42, "name": "Roundtrip Aegis", "slot": "armor", "rarity": "Rare", "source": "CI test", "enhancement_level": 3, "attack": 0, "hp": 20, "mitigation": 2}
	save.set_value("character", "name", "CI Gear Tester")
	save.set_value("character", "class", "Warden")
	save.set_value("player", "level", 5)
	save.set_value("player", "xp", 0)
	save.set_value("player", "xp_to_next_level", 100)
	save.set_value("player", "coins", 77)
	save.set_value("player", "hp", 120)
	save.set_value("attributes", "strength_rank", 2)
	save.set_value("attributes", "vitality_rank", 2)
	save.set_value("equipment", "weapon_level", 1)
	save.set_value("equipment", "armor_level", 1)
	save.set_value("equipment", "loot_gear", [weapon, armor])
	save.set_value("equipment", "equipped_loot_weapon_id", 41)
	save.set_value("equipment", "equipped_loot_armor_id", 42)
	save.set_value("equipment", "next_loot_gear_id", 43)
	var write_error := save.save(save_path)
	_check(write_error == OK, "write fixture save")
	if write_error != OK:
		quit(1)
		return
	var game_script: Script = load("res://scripts/main_3d.gd")
	var first = game_script.new()
	first.call("_load_progress")
	_check((first.get("loot_gear") as Array).size() == 2, "load both loot items")
	_check(int(first.get("equipped_loot_weapon_id")) == 41, "restore equipped weapon ID")
	_check(int(first.get("equipped_loot_armor_id")) == 42, "restore equipped armor ID")
	_check(int(first.call("_basic_attack_damage")) == 60, "apply base and enhancement weapon bonuses to basic damage")
	_check(int(first.get("player_max_hp")) == 238, "apply base and enhancement armor HP to max health")
	_check(int(first.call("_armor_mitigation")) == 6, "apply armor enhancement mitigation bonus")
	_check(int(first.call("_gear_attack", first.get("loot_gear")[0])) == 11, "enhancement adds attack to weapon")
	_check(int(first.call("_gear_hp", first.get("loot_gear")[1])) == 44, "enhancement adds health to armor")
	first.call("_save_progress")
	var second = game_script.new()
	second.call("_load_progress")
	var reloaded_items: Array = second.get("loot_gear")
	_check(reloaded_items.size() == 2, "round-trip preserves item collection")
	_check(int(second.get("equipped_loot_weapon_id")) == 41, "round-trip preserves weapon equip")
	_check(int(second.get("equipped_loot_armor_id")) == 42, "round-trip preserves armor equip")
	_check(int(second.call("_basic_attack_damage")) == 60, "round-trip preserves enhanced weapon bonus")
	_check(int(second.get("player_max_hp")) == 238, "round-trip preserves enhanced armor health bonus")
	_check(int(second.call("_armor_mitigation")) == 6, "round-trip preserves enhanced armor mitigation")
	_check(int(second.get("loot_gear")[0].get("enhancement_level", 0)) == 2, "round-trip preserves weapon enhancement level")
	_check(int(second.get("loot_gear")[1].get("enhancement_level", 0)) == 3, "round-trip preserves armor enhancement level")
	_check(int(second.get("next_loot_gear_id")) == 43, "round-trip preserves next item ID")
	var legacy := ConfigFile.new()
	legacy.set_value("character", "name", "Legacy Save")
	legacy.set_value("character", "class", "Warden")
	legacy.set_value("equipment", "weapon_level", 1)
	legacy.set_value("equipment", "armor_level", 1)
	var legacy_error := legacy.save(save_path)
	_check(legacy_error == OK, "write legacy save fixture without loot fields")
	var old_game = game_script.new()
	old_game.call("_load_progress")
	_check((old_game.get("loot_gear") as Array).is_empty(), "legacy save without loot remains compatible")
	_check(int(old_game.get("equipped_loot_weapon_id")) == 0, "legacy save clears missing equipped weapon ID")
	var legacy_gear_save := ConfigFile.new()
	legacy_gear_save.set_value("equipment", "loot_gear", [{"id": 8, "name": "Old Sword", "slot": "weapon", "rarity": "Rare", "attack": 5, "hp": 0, "mitigation": 0}])
	_check(legacy_gear_save.save(save_path) == OK, "write old gear without enhancement field")
	var legacy_gear_game = game_script.new()
	legacy_gear_game.call("_load_progress")
	_check(int(legacy_gear_game.get("loot_gear")[0].get("enhancement_level", -1)) == 0, "old gear defaults to enhancement +0")
	var enhancement_game = game_script.new()
	enhancement_game.set("loot_gear", [{"id": 90, "name": "Upgrade Test", "slot": "weapon", "rarity": "Common", "source": "CI", "enhancement_level": 0, "attack": 5, "hp": 0, "mitigation": 0}])
	enhancement_game.set("selected_gear_id", 90)
	enhancement_game.set("coins", 500)
	enhancement_game.set("inventory", {"Ashen Pelt": 2, "Ancient Shard": 2, "Echo Fragment": 0, "Ruin Core": 0, "Warden Emblem": 0, "Frost Sigil": 0, "Glacial Crown": 0})
	enhancement_game.call("_enhance_selected_loot")
	_check(int(enhancement_game.get("loot_gear")[0].get("enhancement_level", 0)) == 1, "enhancement upgrades selected gear by one level")
	_check(int(enhancement_game.get("coins")) == 460, "enhancement consumes rarity-scaled coin cost")
	_check(int(enhancement_game.get("inventory").get("Ancient Shard", 0)) == 1, "enhancement consumes primary material")
	_check(int(enhancement_game.get("inventory").get("Ashen Pelt", 0)) == 1, "enhancement consumes secondary material")
	var insufficient_game = game_script.new()
	insufficient_game.set("loot_gear", [{"id": 91, "name": "Poor Test", "slot": "weapon", "rarity": "Common", "source": "CI", "enhancement_level": 0, "attack": 5, "hp": 0, "mitigation": 0}])
	insufficient_game.set("selected_gear_id", 91)
	insufficient_game.set("coins", 0)
	insufficient_game.set("inventory", {"Ashen Pelt": 0, "Ancient Shard": 0, "Echo Fragment": 0, "Ruin Core": 0, "Warden Emblem": 0, "Frost Sigil": 0, "Glacial Crown": 0})
	insufficient_game.call("_enhance_selected_loot")
	_check(int(insufficient_game.get("loot_gear")[0].get("enhancement_level", 0)) == 0, "insufficient resources do not upgrade gear")
	DirAccess.remove_absolute(ProjectSettings.globalize_path(save_path))
	if failed:
		push_error("Equipment save/load regression suite FAILED.")
		quit(1)
	else:
		print("Equipment save/load regression suite PASSED.")
		quit(0)
