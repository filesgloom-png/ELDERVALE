; ELDERVALE — Godot 4.5.1
config_version=5

[application]
config/name="ELDERVALE"
config/description="A third-person 3D dark fantasy action RPG for Android."
run/main_scene="res://scenes/main_3d.tscn"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=960
window/size/window_height_override=540
window/stretch/mode="canvas_items"
window/handheld/orientation=0

[rendering]
textures/vram_compression/import_etc2_astc=true
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.035, 0.047, 0.043, 1)

[physics]
3d/default_gravity=9.8

[gui]
theme/default_font_multichannel_signed_distance_field=true
